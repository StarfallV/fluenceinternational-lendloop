# Next.js environment variables, documented here; the values live in .env.local, which is
# gitignored and never committed (CLAUDE.md, docs/security.md §5). `npx convex dev` creates
# .env.local on its first run, so add the Clerk lines to that file rather than copying this one
# over it. The n8n stack's variables live in .env.n8n instead (.env.n8n.example, block 007).
# CLERK_JWT_ISSUER_DOMAIN belongs in the Convex env, not here (README, Development).

# Convex: written by `npx convex dev` on its first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk: from the Clerk dashboard's API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret. Never commit it, and never give it to Convex.
CLERK_SECRET_KEY=
