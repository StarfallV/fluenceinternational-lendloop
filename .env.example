# Next.js environment variables. Copy this file to .env.local and fill in the values there.
# .env.local is gitignored and never committed (CLAUDE.md, docs/security.md §5).
# The n8n stack's variables live in .env.n8n instead (.env.n8n.example, block 007).

# Convex: written by `npx convex dev` on first run (block 002).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk: from the Clerk dashboard, API keys page (block 002).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret. Never commit it, and never give it to Convex.
CLERK_SECRET_KEY=
