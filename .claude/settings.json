{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(/.env.development)",
      "Read(/.env.production)",
      "Read(/.env.test)",
      "Read(/.env.n8n)",
      "Read(/.secrets/**)",
      "Read(/.convex/**)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/.env.*.local)",
      "Edit(/.env.development)",
      "Edit(/.env.production)",
      "Edit(/.env.test)",
      "Edit(/.env.n8n)",
      "Edit(/.secrets/**)",
      "Edit(/.convex/**)",
      "Bash(cat *.env*)",
      "Bash(cat *.secrets*)",
      "Bash(head *.env*)",
      "Bash(head *.secrets*)",
      "Bash(tail *.env*)",
      "Bash(tail *.secrets*)",
      "Bash(less *.env*)",
      "Bash(less *.secrets*)",
      "Bash(source *.env*)",
      "Bash(npx convex env list*)",
      "Bash(npx convex env get*)",
      "Bash(node *convex* env list*)",
      "Bash(node *convex* env get*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *.secrets*)",
      "PowerShell(gc *.env*)",
      "PowerShell(gc *.secrets*)",
      "PowerShell(cat *.env*)",
      "PowerShell(cat *.secrets*)",
      "PowerShell(type *.env*)",
      "PowerShell(type *.secrets*)",
      "PowerShell(npx convex env list*)",
      "PowerShell(npx convex env get*)",
      "PowerShell(node *convex* env list*)",
      "PowerShell(node *convex* env get*)",
      "PowerShell(& *convex* env list*)",
      "PowerShell(& *convex* env get*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
