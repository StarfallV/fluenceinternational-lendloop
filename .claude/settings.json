{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.n8n)",
      "Read(./.secrets/**)",
      "Bash(cat *.env*)",
      "Bash(cat *.secrets*)",
      "Bash(head *.env*)",
      "Bash(head *.secrets*)",
      "Bash(tail *.env*)",
      "Bash(tail *.secrets*)",
      "Bash(less *.env*)",
      "Bash(less *.secrets*)",
      "Bash(grep *.env*)",
      "Bash(grep *.secrets*)",
      "Bash(source *.env*)",
      "Bash(npx convex env list*)",
      "Bash(npx convex env get*)",
      "Bash(node *convex* env list*)",
      "Bash(node *convex* env get*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *.secrets*)",
      "PowerShell(gc *.env*)",
      "PowerShell(gc *.secrets*)",
      "PowerShell(cat *.env*)",
      "PowerShell(cat *.secrets*)",
      "PowerShell(type *.env*)",
      "PowerShell(type *.secrets*)",
      "PowerShell(Select-String *.env*)",
      "PowerShell(Select-String *.secrets*)",
      "PowerShell(npx convex env list*)",
      "PowerShell(npx convex env get*)",
      "PowerShell(node *convex* env list*)",
      "PowerShell(node *convex* env get*)",
      "PowerShell(& *convex* env list*)",
      "PowerShell(& *convex* env get*)"
    ]
  }
}
