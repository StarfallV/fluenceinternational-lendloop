{
  "name": "lendloop",
  "version": "0.0.0",
  "private": true,
  "description": "A neighborhood tool-lending board built with Next.js, Clerk, Convex and n8n.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:ids": "tsx scripts/check-ids.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
